{
  // F5 o panel "Ejecutar y depurar" (Ctrl+Mayús+D) -> elegir configuración
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fetch: mañana (D+1)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.fetch_pvpc",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Fetch: fecha concreta",
      "type": "debugpy",
      "request": "launch",
      "module": "src.fetch_pvpc",
      "args": ["--fecha", "${input:fecha}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Fetch: día de 25 h (2026-10-25)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.fetch_pvpc",
      "args": ["--fecha", "2026-10-25"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Fetch: día de 23 h (2026-03-29)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.fetch_pvpc",
      "args": ["--fecha", "2026-03-29"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Fetch: plan B REData (sin guardar)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.fetch_pvpc",
      "args": ["--fecha", "${input:fecha}", "--fuente", "redata", "--no-guardar"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Comprobar credenciales",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/check_credentials.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "fecha",
      "type": "promptString",
      "description": "Fecha a consultar (YYYY-MM-DD)",
      "default": "2026-11-04"
    }
  ]
}
