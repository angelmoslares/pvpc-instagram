# Copia este archivo como .env (en la raíz del repo) y rellena los valores.
# .env está en .gitignore: nunca se sube a GitHub.
# En GitHub Actions estos mismos nombres vienen de GitHub Secrets.

# Token personal de ESIOS (pedido a consultasios@ree.es)
ESIOS_TOKEN=

# Token de Instagram (Instagram API with Instagram Login, ~60 días)
IG_TOKEN=

# ID de la cuenta profesional de Instagram (campo user_id de /me)
IG_USER_ID=

# Versión de la Graph API de Instagram
IG_API_VERSION=v26.0
