# Copia este archivo como .env (en la raíz del repo) y rellena los valores.
# .env está en .gitignore: nunca se sube a GitHub.
# En GitHub Actions estos mismos nombres vienen de GitHub Secrets.

# Token personal de ESIOS (pedido a consultasios@ree.es)
ESIOS_TOKEN=

# Token de Instagram. Método actual: API de Instagram con inicio de sesión con Facebook.
# Es un token de PÁGINA (empieza por EAA) sacado de un token de usuario de larga duración:
# no caduca, pero el acceso a datos hay que renovarlo cada ~90 días reautorizando la app.
IG_TOKEN=

# ID de la cuenta de Instagram: campo instagram_business_account.id de la página
IG_USER_ID=

# ID de la página de Facebook vinculada (informativo)
IG_PAGE_ID=

# Versión de la Graph API
IG_API_VERSION=v27.0

# Opcional: forzar host (por defecto se deduce del token: EAA → graph.facebook.com)
# IG_GRAPH_HOST=graph.facebook.com
